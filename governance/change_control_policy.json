{
  "schema_version": "1.1",
  "baseline_ref": "origin/baseline/master-2026-09-11",
  "change_request_glob": "governance/change_requests/*.json",
  "risk_levels": ["low", "moderate", "high", "critical"],
  "authorization_defaults": {
    "production_authorized": false,
    "publication_authorized": false,
    "commercial_authorized": false
  },
  "scope_rules": {
    "governance": ["governance/**", ".github/workflows/**"],
    "runtime": ["main.py", "netlify.toml", "railway.json", "Procfile", "Dockerfile", "docker-compose.yml"],
    "commerce": ["main.py", "index.html", "terms.html", "refunds.html", "governance/master_manifest.json"],
    "security": ["main.py", "netlify.toml", "privacy.html", ".github/workflows/**", "tools/**"],
    "privacy": ["privacy.html", "main.py", "terms.html"],
    "legal": ["terms.html", "privacy.html", "refunds.html", "governance/master_manifest.json"],
    "safety": ["main.py", "governance/master_manifest.json"],
    "brand": ["index.html", "README.md", "governance/**"],
    "dependencies": ["requirements.txt", "requirements-test.txt", "pyproject.toml", "poetry.lock", "Pipfile", "Pipfile.lock"],
    "tests": ["tests/**"],
    "documentation": ["*.md", "docs/**", "governance/**"]
  },
  "minimum_risk_by_scope": {
    "governance": "moderate",
    "runtime": "high",
    "commerce": "high",
    "security": "high",
    "privacy": "high",
    "legal": "high",
    "safety": "critical",
    "brand": "moderate",
    "dependencies": "high",
    "tests": "low",
    "documentation": "low"
  },
  "review_requirements": {
    "security": ["security"],
    "privacy": ["privacy"],
    "legal": ["legal"],
    "safety": ["safety", "council"],
    "commerce": ["commerce", "council"],
    "runtime": ["architecture"],
    "governance": ["architecture"]
  },
  "self_modification_paths": [
    "tools/change_control.py",
    "governance/change_control_policy.json",
    ".github/workflows/change-control-gate.yml"
  ],
  "self_modification_minimum_risk": "high",
  "protected_manifest": "governance/master_manifest.json"
}
