{
  "schema_version": "1.0",
  "engine": "JakeAI Module Sandbox Engine",
  "baseline_ref": "baseline/master-v2-2026-09-11",
  "module_root": "modules",
  "manifest_name": "module.json",
  "allowed_module_kinds": ["product", "game", "social", "content", "integration", "internal-tool"],
  "protected_core_paths": [
    "main.py",
    "netlify.toml",
    "railway.json",
    "Procfile",
    "Dockerfile",
    "docker-compose.yml",
    "governance/master_manifest.json",
    "governance/change_control_policy.json",
    "tools/change_control.py",
    ".github/workflows/change-control-gate.yml"
  ],
  "module_authorization_defaults": {
    "production_authorized": false,
    "publication_authorized": false,
    "commercial_authorized": false
  },
  "required_manifest_fields": [
    "schema_version",
    "module_id",
    "name",
    "kind",
    "owner",
    "purpose",
    "entrypoints",
    "capabilities",
    "dependencies",
    "data_access",
    "network_access",
    "secrets_required",
    "production_authorized",
    "publication_authorized",
    "commercial_authorized"
  ],
  "forbidden_module_behaviors": [
    "write-outside-own-module",
    "embed-secret",
    "self-authorize-production",
    "self-authorize-publication",
    "self-authorize-commerce",
    "modify-protected-core"
  ]
}
