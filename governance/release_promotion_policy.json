{
  "schema_version": "1.0",
  "engine": "JakeAI Release & Promotion Engine",
  "source_baseline": "baseline/master-v5-2026-09-11",
  "candidate_manifest": "build/production_candidate/candidate_manifest.json",
  "candidate_fingerprint": "build/production_candidate/candidate_fingerprint.json",
  "promotion_request": "governance/promotion_request.json",
  "release_output": "build/release_promotion/release_plan.json",
  "rollback_output": "build/release_promotion/rollback_plan.json",
  "defaults": {
    "promotion_authorized": false,
    "deployment_authorized": false,
    "publication_authorized": false,
    "commercial_activation_authorized": false
  },
  "required_approval_states": {
    "architecture": "approved",
    "security": "approved",
    "commerce": "approved",
    "legal": "approved",
    "council": "approved",
    "human": "approved"
  },
  "required_request_fields": [
    "schema_version",
    "status",
    "candidate_manifest_sha256",
    "candidate_builder_head",
    "target",
    "reviews",
    "human_approval_record",
    "promotion_authorized",
    "deployment_authorized",
    "publication_authorized",
    "commercial_activation_authorized"
  ],
  "allowed_targets": ["production"],
  "release_invariants": [
    "exact_candidate_fingerprint_match",
    "all_required_reviews_approved",
    "explicit_human_approval_record",
    "no_implicit_authorization",
    "rollback_target_recorded_before_release",
    "release_plan_is_non_executing",
    "deployment_requires_separate_explicit_action"
  ]
}
