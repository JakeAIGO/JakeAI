{
  "schema_version": "1.0",
  "engine": "JakeAI Production Candidate Builder",
  "baseline_ref": "baseline/master-v4-2026-09-11",
  "commercial_registry": "governance/commercial_rules_registry.json",
  "module_root": "modules",
  "artifact_root": "build/production_candidate",
  "authorization_defaults": {
    "production_authorized": false,
    "publication_authorized": false,
    "commercial_authorized": false
  },
  "inclusion_rules": {
    "module_requires_production_authorized": true,
    "module_requires_publication_authorized": true,
    "commercial_product_requires_commercial_authorized": true,
    "commercial_product_requires_checkout_authorized": true,
    "fail_closed_on_missing_metadata": true
  },
  "forbidden_actions": [
    "merge-to-main",
    "deploy-production",
    "publish-publicly",
    "activate-checkout",
    "spend-money",
    "move-baseline-anchor"
  ],
  "required_outputs": [
    "candidate_manifest.json",
    "candidate_fingerprint.json",
    "candidate_review.md"
  ]
}
