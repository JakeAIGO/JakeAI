[gd_scene load_steps=2 format=3]
[ext_resource path="res://scripts/SettingsPanel.gd" type="Script" id="1"]
[node name="SettingsPanel" type="Control"]
script = ExtResource("1")
[node name="Panel" type="PanelContainer" parent="."]
offset_left=300.0
offset_top=140.0
offset_right=980.0
offset_bottom=570.0
[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode=2
[node name="Title" type="Label" parent="Panel/VBox"]
text="SETTINGS & ACCESSIBILITY"
[node name="MasterLabel" type="Label" parent="Panel/VBox"]
text="Master Volume"
[node name="Master" type="HSlider" parent="Panel/VBox"]
max_value=100.0
value=80.0
[node name="Shake" type="CheckButton" parent="Panel/VBox"]
text="Screen Shake"
[node name="ReduceMotion" type="CheckButton" parent="Panel/VBox"]
text="Reduce Motion"
[node name="FlashLabel" type="Label" parent="Panel/VBox"]
text="Flash Intensity"
[node name="Flash" type="HSlider" parent="Panel/VBox"]
max_value=100.0
value=100.0
[connection signal="value_changed" from="Panel/VBox/Master" to="." method="_on_master_value_changed"]
[connection signal="toggled" from="Panel/VBox/Shake" to="." method="_on_shake_toggled"]
[connection signal="toggled" from="Panel/VBox/ReduceMotion" to="." method="_on_reduce_motion_toggled"]
[connection signal="value_changed" from="Panel/VBox/Flash" to="." method="_on_flash_value_changed"]
